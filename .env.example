# ===========================================
# Thind Transport Website — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (or any file with real secrets) to version control.

# -------------------------------------------
# EMAIL (required for application / lead / meeting forms)
# -------------------------------------------
# For Gmail:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Thind Transport <noreply@thindtransport.com>

# Where driver application PDFs are delivered
HR_EMAIL=hr@thindtransport.com
FROM_EMAIL=noreply@thindtransport.com

# -------------------------------------------
# AUTH (required for the driver portal)
# -------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Invitation code required to register a driver portal account
DRIVER_INVITATION_CODE=

# -------------------------------------------
# DATABASE (optional — falls back to local JSON files when unset)
# -------------------------------------------
# Vercel Postgres / Neon connection string
POSTGRES_URL=

# -------------------------------------------
# ADMIN (optional)
# -------------------------------------------
# Token required to call GET /api/setup-db (one-time DB initialization)
SETUP_DB_TOKEN=

# -------------------------------------------
# HAULDESK HUB (optional — operations product under /hub)
# Full go-live checklist: docs/hub-go-live-requirements.md
# -------------------------------------------
# Protects /api/hub/cron/* (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# Web Push (VAPID) for hub notifications — generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# Encrypts per-carrier integration credentials at rest (32+ random chars)
CREDENTIALS_KEY=

# Free FMCSA QCMobile webkey (mobile.fmcsa.dot.gov) — broker authority vetting
FMCSA_WEBKEY=

# Free EIA open-data key (eia.gov) — weekly diesel index on the fuel screen
EIA_API_KEY=

# Optional — Smart Setup LLM document extraction (Anthropic). Heuristics work without it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Self-hosted Nominatim (or compatible) for platform-scale geocoding
GEOCODER_BASE_URL=
