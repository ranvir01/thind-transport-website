# ===========================================
# Thind Transport Website — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (or any file with real secrets) to version control.

# -------------------------------------------
# EMAIL (required for application / lead / meeting forms)
# -------------------------------------------
# For Gmail:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Thind Transport <noreply@thindtransport.com>

# Where driver application PDFs are delivered
HR_EMAIL=hr@thindtransport.com
FROM_EMAIL=noreply@thindtransport.com

# -------------------------------------------
# AUTH (required for the driver portal)
# -------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Invitation code required to register a driver portal account
DRIVER_INVITATION_CODE=

# -------------------------------------------
# DATABASE (optional — falls back to local JSON files when unset)
# -------------------------------------------
# Vercel Postgres / Neon connection string
POSTGRES_URL=

# -------------------------------------------
# ADMIN (optional)
# -------------------------------------------
# Token required to call GET /api/setup-db (one-time DB initialization)
SETUP_DB_TOKEN=
