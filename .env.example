# ===========================================
# Thind Transport Website — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (or any file with real secrets) to version control.

# -------------------------------------------
# EMAIL (required for application / lead / meeting forms)
# -------------------------------------------
# For Gmail:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Thind Transport <noreply@thindtransport.com>"
# Legacy aliases (src/lib/mailer.ts falls back to these if SMTP_USER/SMTP_PASS are unset) —
# only needed if you're carrying over an older .env.local, prefer SMTP_USER/SMTP_PASS above
# EMAIL_USER=
# EMAIL_PASS=

# Where driver application PDFs are delivered
HR_EMAIL=hr@thindtransport.com

# -------------------------------------------
# AUTH (required for the driver portal)
# -------------------------------------------
# Generate a secret with: openssl rand -base64 32
# Auth.js v5 reads AUTH_SECRET natively; NEXTAUTH_SECRET is checked as a
# fallback (see next-auth/lib/env.js) — either name works, set one.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Invitation code required to register a driver portal account
DRIVER_INVITATION_CODE=

# -------------------------------------------
# DATABASE (optional — falls back to local JSON files when unset)
# -------------------------------------------
# Vercel Postgres / Neon connection string
POSTGRES_URL=

# -------------------------------------------
# ADMIN (optional)
# -------------------------------------------
# Token required to call GET /api/setup-db (one-time DB initialization)
SETUP_DB_TOKEN=

# -------------------------------------------
# HAULDESK HUB (optional — operations product under /hub)
# Full go-live checklist: docs/hub-go-live-requirements.md
# -------------------------------------------
# Protects /api/hub/cron/* (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# Web Push (VAPID) for hub notifications — generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# Encrypts per-carrier integration credentials at rest (32+ random chars)
CREDENTIALS_KEY=

# Vercel Blob token — durable storage for POD uploads and generated PDFs.
# Vercel's filesystem is ephemeral between invocations: without this, uploaded
# documents and invoice/settlement PDFs are lost. Falls back to local disk
# (data/uploads) only when unset, which is fine for local dev, not production.
# Checked by `npm run go-live:check`. Create a Blob store in the Vercel
# dashboard to get this token.
BLOB_READ_WRITE_TOKEN=

# Free FMCSA QCMobile webkey (mobile.fmcsa.dot.gov) — broker authority vetting
FMCSA_WEBKEY=

# Free EIA open-data key (eia.gov) — weekly diesel index on the fuel screen
EIA_API_KEY=

# Optional — Smart Setup LLM document extraction (Anthropic). Heuristics work without it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Mapbox PUBLIC token (pk....) — richer fleet-map tiles + routing-grade driving
# miles (loaded/empty miles feed pay, IFTA, and cost-per-mile). Free tier: 50k
# loads/mo. Falls back to free OpenStreetMap tiles + manual miles when unset.
# Get one at https://account.mapbox.com (public token is safe in the browser).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-side fallback if you'd rather not expose the token as NEXT_PUBLIC_* — read by
# src/lib/hub/mapbox.ts only when NEXT_PUBLIC_MAPBOX_TOKEN is unset (client-side map tiles
# in FleetMap.tsx still need the NEXT_PUBLIC_ variant to work in the browser)
# MAPBOX_TOKEN=

# Self-hosted Nominatim (or compatible) for platform-scale geocoding
GEOCODER_BASE_URL=

# -------------------------------------------
# HAULDESK SIDECARS (optional — pure TypeScript when unset)
# See docs/architecture/trilingual-stack.md
# -------------------------------------------
# Go worker — routing proxy, integration sync, cron-scale jobs (:8081)
HAULDESK_GO_WORKER_URL=
# Rust compute — IFTA math, bulk CSV, CPU-heavy jobs (:8082)
HAULDESK_RUST_COMPUTE_URL=

# Free drive-miles routing for "Suggest miles". Defaults to the public OSRM demo
# (fine for one carrier); point at a self-hosted OSRM to remove the rate limit.
OSRM_URL=

# Small-carrier mode (default on): trims nav + ⌘K to what one small carrier runs.
# Hidden screens stay reachable by URL. Set to false to surface every module.
SMALL_CARRIER_MODE=true

# Go-live: set to false in production to hide the demo-credentials card AND
# refuse sign-in for the seeded @demo.thind accounts. Default on for evaluation.
HUB_DEMO_LOGIN=true

# Shared secret for the Go/Rust sidecars: when set, sidecars reject requests
# without a matching X-Hauldesk-Secret header (sent automatically by the TS
# gateway). REQUIRED before exposing a sidecar beyond localhost.
HAULDESK_SIDECAR_SECRET=
