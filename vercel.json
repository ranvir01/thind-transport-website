{
  "buildCommand": "node scripts/hub-migrate.mjs --if-db && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    {
      "path": "/api/hub/cron/migrate",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/hub/cron/compliance-scan",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/hub/cron/auto-invoice",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/hub/cron/ar-reminders",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/hub/cron/detention-alerts",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/hub/cron/task-automations",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/hub/cron/recurring-rebook",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/hub/cron/recompute-lanes",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/hub/cron/driver-scorecards",
      "schedule": "0 10 1 * *"
    },
    {
      "path": "/api/hub/cron/fmcsa-recheck",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/hub/cron/telematics-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/hub/cron/docs-mailbox",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/hub/cron/efs-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/hub/cron/wex-sync",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/hub/cron/comdata-sync",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/hub/cron/qbo-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/hub/cron/owner-digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/hub/cron/random-testing",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/hub/cron/universal-sync",
      "schedule": "50 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!_next/static|images|logos|favicon|templates).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/templates/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pay.html",
      "destination": "/pay-rates",
      "permanent": true
    },
    {
      "source": "/application.html",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/testimonials.html",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/components-showcase.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "permanent": false
    }
  ]
}