# Canvas native deps for node-canvas (PDF tooling scripts).
# Layered on Cursor's Ubuntu base — run before npm install in environment.json.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*
