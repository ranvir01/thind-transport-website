# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.vercel.*
vercel-env*.txt

# vercel
.vercel

# local runtime data (JSON fallback storage + uploads)
/data
/uploads

# bundled node distributions (never commit these)
/node
node*.tar.xz

# local logs
dev.log

# typescript
*.tsbuildinfo
next-env.d.ts

# vite (legacy)
dist-legacy

# HaulDesk local artifacts
e2e-shots*/
e2e-sweep/
e2e-run-all-logs*/
/bin/
services/**/target/
services/go/hauldesk-worker/hauldesk-worker

*.deb

# design-qa auditor output
.design-qa/
.agent-scratch/

# personal working materials (prompts, scratch notes) — see
# docs/ops/OWNER_DEV_WORKFLOW.md §5; never commit these
scratch/
prompts/
*.local.md
qa-matrix/
